    "rows": [
     {
      "id": "CH-01",
      "values": {
       "ch.name": "レミュエル・ガリヴァー",
       "ch.desire": "世界を見たい。家族を養う稼ぎを得たい（本文）",
       "ch.wound": "師匠ベイツの死後、医者の商売が傾き、やむなく航海に出た（本文）",
       "ch.voice": "丁寧で几帳面な手記の語り。数字と寸法を必ず言う（創作）",
       "ch.relations": "皇帝に仕える。レルドレサルと友。フリムナップとボルゴラムに憎まれる",
       "ch.first": "1話、難破と浜",
       "ch.look": "1,750 mm、青い上着（金の縁取りなし・真鍮のボタン）、茶の半ズボン、白い靴下、黒い靴（AR-06）",
       "ch.change": "皇帝の重用から弾劾へ。最後はブレフスキュへ逃れ、英国の家族のもとへ帰る",
       "rel.serve": "CH-02",
       "rel.ally": null,
       "rel.enemy": null,
       "rel.grudge": null,
       "rel.judge": null,
       "rel.rescue": null,
       "rel.spouse": "CH-10"
      }
     },
     {
      "id": "CH-02",
      "values": {
       "ch.name": "リリパット皇帝",
       "ch.desire": "ブレフスキュを属州にし、世界でただ一人の君主になる（本文）",
       "ch.wound": "大きな客人を持ちながら、思いどおりには使えない（推定）",
       "ch.voice": "儀礼的で尊大。宣告の文体（創作）",
       "ch.relations": "ガリヴァーを重用し、後に処罰を決める",
       "ch.first": "1話、運搬機の後",
       "ch.look": "廷臣より爪の幅ほど背が高い。鷲鼻、オリーブ色の肌、金の兜と羽根の兜、剣（本文、色は創作）",
       "ch.change": "艦隊の功でガリヴァーを重用するが、ブレフスキュを滅ぼすことを断られてから遠ざけ、弾劾で失明の刑を決める",
       "rel.serve": null,
       "rel.ally": null,
       "rel.enemy": null,
       "rel.grudge": null,
       "rel.judge": "CH-01",
       "rel.rescue": null,
       "rel.spouse": null
      }
     },
     {
      "id": "CH-03",
      "values": {
       "ch.name": "皇后",
       "ch.desire": "王宮と自分の居所を守る（推定）",
       "ch.wound": "自分の居室の火事を尿で消された（本文）",
       "ch.voice": "短く冷たい（創作）",
       "ch.relations": "火事の後、ガリヴァーを恨む",
       "ch.first": "2話、宮廷",
       "ch.look": "小柄、重い衣装（創作）",
       "ch.change": "火事の前は無関係。火事の後、居室を二度と使わないと誓い、ガリヴァーを恨む",
       "rel.serve": null,
       "rel.ally": null,
       "rel.enemy": null,
       "rel.grudge": "CH-01",
       "rel.judge": null,
       "rel.rescue": null,
       "rel.spouse": null
      }
     },
     {
      "id": "CH-04",
      "values": {
       "ch.name": "フリムナップ（大蔵大臣）",
       "ch.desire": "国庫と自分の地位を守る（本文）",
       "ch.wound": "妻とガリヴァーの噂に嫉妬する（本文）",
       "ch.voice": "冷ややかな勘定の言葉（創作）",
       "ch.relations": "ガリヴァーの敵。弾劾に加わる",
       "ch.first": "2話、綱渡り",
       "ch.look": "綱渡りが一番上手（本文）。痩せた長身（創作）",
       "ch.change": "最初から敵。噂への嫉妬で、弾劾に加わる",
       "rel.serve": "CH-02",
       "rel.ally": null,
       "rel.enemy": "CH-01",
       "rel.grudge": null,
       "rel.judge": null,
       "rel.rescue": null,
       "rel.spouse": null
      }
     },
     {
      "id": "CH-05",
      "values": {
       "ch.name": "レルドレサル（内廷の首席秘書官）",
       "ch.desire": "皇帝とガリヴァーの両方に忠実でいたい（推定）",
       "ch.wound": "友の両目を潰す案を「慈悲」として出す（本文）",
       "ch.voice": "穏やかで理屈を重ねる（創作）",
       "ch.relations": "ガリヴァーの友。教会の対立と戦争を説く",
       "ch.first": "3話、戦争の説明",
       "ch.look": "細い目、穏やかな顔（創作）",
       "ch.change": "友として戦争の事情を説くが、弾劾では死罪の代わりに失明を出す",
       "rel.serve": "CH-02",
       "rel.ally": "CH-01",
       "rel.enemy": null,
       "rel.grudge": null,
       "rel.judge": null,
       "rel.rescue": null,
       "rel.spouse": null
      }
     },
     {
      "id": "CH-06",
      "values": {
       "ch.name": "スカイレッシュ・ボルゴラム（海軍大将）",
       "ch.desire": "自分の武功を守る（推定）",
       "ch.wound": "艦隊を引いた手柄を外国人に奪われた（推定）",
       "ch.voice": "不機嫌で粗い（創作）",
       "ch.relations": "ガリヴァーの一番の敵。弾劾を主導",
       "ch.first": "2話、解放の条件",
       "ch.look": "陰気な顔つき（本文）。太い体（創作）",
       "ch.change": "解放の条件の時から敵意を持ち、艦隊の後に弾劾を主導する",
       "rel.serve": "CH-02",
       "rel.ally": null,
       "rel.enemy": "CH-01",
       "rel.grudge": null,
       "rel.judge": null,
       "rel.rescue": null,
       "rel.spouse": null
      }
     },
     {
      "id": "CH-07",
      "values": {
       "ch.name": "ブレフスキュ皇帝",
       "ch.desire": "和平と、ガリヴァーを自国に引き留めること（推定）",
       "ch.wound": "艦隊を奪われた（本文）",
       "ch.voice": "寛大で落ち着いている（創作）",
       "ch.relations": "ガリヴァーを迎え、引き渡しを断る",
       "ch.first": "4話、和平の使節",
       "ch.look": "CH-02と見分けられるよう、丸い顔と銀の冠（創作）",
       "ch.change": "艦隊を奪われた敵国の君主から、ガリヴァーを迎え入れて帰国を助ける人へ",
       "rel.serve": null,
       "rel.ally": null,
       "rel.enemy": null,
       "rel.grudge": null,
       "rel.judge": null,
       "rel.rescue": "CH-01",
       "rel.spouse": null
      }
     },
     {
