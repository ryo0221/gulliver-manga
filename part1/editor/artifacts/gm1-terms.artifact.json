      "te.ruby": false,
      "te.avoid": "—"
     }
    },
    {
     "id": "TE-06",
     "values": {
      "te.text": "ゴルバスト・モマレム・エブラメ・グルディロ・シェフィン・モリー・ウリー・グエ",
      "te.source": "Golbasto Momarem Evlame Gurdilo Shefin Mully Ully Gue",
      "te.kind": "CH-02の名",
      "te.ruby": false,
      "te.avoid": "台詞では「皇帝」。全名は宣告の場面だけ"
     }
    },
    {
     "id": "TE-07",
     "values": {
      "te.text": "フリムナップ",
