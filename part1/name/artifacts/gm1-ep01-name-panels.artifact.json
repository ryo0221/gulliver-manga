      "nm.order": 2,
      "nm.scene": "SC-004",
      "nm.shot": "寄り",
      "nm.eye": "ガリヴァーの目の高さ",
      "nm.mm": 200,
      "nm.look": "左腕の脇から",
      "nm.size": false,
      "nm.art": "もがいて、左腕の紐を引きちぎる。",
      "nm.lines": "SC-004.L11 SC-004.L12",
      "nm.text": "擬音：ブチブチッ",
      "nm.turn": ""
     }
    },
    {
