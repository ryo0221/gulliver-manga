    {
     "id": "e01-p01-k1",
     "values": {
      "nm.page": 1,
      "nm.order": 1,
      "nm.scene": "SC-001",
      "nm.shot": "大引き",
      "nm.eye": "小人の目の高さ",
      "nm.mm": 136,
      "nm.look": "胸の上の小人の後ろから、横たわるガリヴァーの顎と顔を見上げる。手前に小人の背中と弓",
      "nm.size": true,
      "nm.art": "扉。浜に縛られて横たわるガリヴァーと、胸の上に立つ小人たち。",
      "nm.lines": "SC-001.L01",
      "nm.text": "",
      "nm.turn": "扉。題と、大きさの違う両者を最初に見せる（AR-05）。"
     }
    },
    {
     "id": "e01-p01-k2",
     "values": {
      "nm.page": 1,
      "nm.order": 2,
      "nm.scene": "SC-001",
      "nm.shot": "引き",
      "nm.eye": "英国の人の目の高さ",
      "nm.mm": 1600,
      "nm.look": "夕方の田舎家と厩を、道から見る",
      "nm.size": false,
      "nm.art": "約5年後。英国の田舎家と厩。",
      "nm.lines": "SC-001.L02",
      "nm.text": "",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p02-k1",
     "values": {
      "nm.page": 2,
      "nm.order": 1,
      "nm.scene": "SC-001",
      "nm.shot": "中",
      "nm.eye": "英国の人の目の高さ",
      "nm.mm": 1600,
      "nm.look": "厩の戸口の内側から、馬と男を横から",
      "nm.size": false,
      "nm.art": "厩の中。二頭の若い馬に低い声で語りかける痩せた中年の男。戸口に妻メアリー。",
      "nm.lines": "SC-001.L03 SC-001.L04 SC-001.L05",
      "nm.text": "台詞（ガリヴァー）：……今日も、あの家の連中の臭いがひどくてな。 / 台詞（ガリヴァー）：おまえたちと話している時だけだ、息ができるのは。",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p02-k2",
     "values": {
      "nm.page": 2,
      "nm.order": 2,
      "nm.scene": "SC-001",
      "nm.shot": "寄り",
      "nm.eye": "英国の人の目の高さ",
      "nm.mm": 1500,
      "nm.look": "馬の鼻先",
      "nm.size": false,
      "nm.art": "馬が鼻を鳴らす。男が嬉しそうに頷く。",
      "nm.lines": "SC-001.L06 SC-001.L07",
      "nm.text": "擬音：ブルル",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p02-k3",
     "values": {
      "nm.page": 2,
      "nm.order": 3,
      "nm.scene": "SC-001",
      "nm.shot": "中",
      "nm.eye": "英国の人の目の高さ",
      "nm.mm": 1600,
      "nm.look": "厩の中から戸口を",
      "nm.size": false,
      "nm.art": "戸口に立つメアリー。中へは入らない。",
      "nm.lines": "SC-001.L08",
      "nm.text": "台詞（メアリー）：……あなた、夕食は。",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p02-k4",
     "values": {
      "nm.page": 2,
      "nm.order": 4,
      "nm.scene": "SC-001",
      "nm.shot": "寄り",
      "nm.eye": "英国の人の目の高さ",
      "nm.mm": 1600,
      "nm.look": "男の肩越しに馬を",
      "nm.size": false,
      "nm.art": "戸口に背を向けたままの男。",
      "nm.lines": "SC-001.L09",
      "nm.text": "台詞（ガリヴァー）：後でいい。",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p02-k5",
     "values": {
      "nm.page": 2,
      "nm.order": 5,
      "nm.scene": "SC-001",
      "nm.shot": "中",
      "nm.eye": "英国の人の目の高さ",
      "nm.mm": 1600,
      "nm.look": "戸口の外から",
      "nm.size": false,
      "nm.art": "目を伏せて去るメアリー。",
      "nm.lines": "SC-001.L10",
      "nm.text": "",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p02-k6",
     "values": {
      "nm.page": 2,
      "nm.order": 6,
      "nm.scene": "SC-001",
      "nm.shot": "引き",
      "nm.eye": "英国の人の目の高さ",
      "nm.mm": 1600,
      "nm.look": "厩の奥から、夕日の差す戸口を背に",
      "nm.size": false,
      "nm.art": "男と馬の後ろ姿。手記の語りが始まる。",
      "nm.lines": "SC-001.L11 SC-001.L12",
      "nm.text": "ナレーション（ガリヴァー）：この手記を、私は旅から帰って5年目に書いている。 / ナレーション（ガリヴァー）：どうしてこうなったのか。初めから記しておく。",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p03-k1",
     "values": {
      "nm.page": 3,
      "nm.order": 1,
      "nm.scene": "SC-002",
      "nm.shot": "大引き",
      "nm.eye": "俯瞰",
      "nm.mm": 12000,
      "nm.look": "ブリストルの港と停泊するアンテロープ号を、帆柱の高さから",
      "nm.size": false,
      "nm.art": "1699年5月4日、ブリストルの港。アンテロープ号。",
      "nm.lines": "SC-002.L01 SC-002.L02",
      "nm.text": "ナレーション（ガリヴァー）：1699年5月4日。私はブリストルからアンテロープ号で南の海へ出た。船医としてである。",
      "nm.turn": "めくると時が戻る（1699年）。"
     }
    },
    {
     "id": "e01-p03-k2",
     "values": {
      "nm.page": 3,
      "nm.order": 2,
      "nm.scene": "SC-002",
      "nm.shot": "中",
      "nm.eye": "英国の人の目の高さ",
      "nm.mm": 1600,
      "nm.look": "岸壁から",
      "nm.size": false,
      "nm.art": "若いガリヴァー（青い上着、真鍮のボタン、金の縁取りなし）が荷を担ぐ。",
      "nm.lines": "SC-002.L03",
      "nm.text": "ナレーション（ガリヴァー）：師のベイツ先生が亡くなってから、ロンドンでの医者の商いは傾く一方だった。",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p03-k3",
     "values": {
      "nm.page": 3,
      "nm.order": 3,
      "nm.scene": "SC-002",
      "nm.shot": "寄り",
      "nm.eye": "英国の人の目の高さ",
      "nm.mm": 1600,
      "nm.look": "ガリヴァーの肩越しに",
      "nm.size": false,
      "nm.art": "メアリー。",
      "nm.lines": "SC-002.L04",
      "nm.text": "台詞（メアリー）：今度はどのくらい？",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p03-k4",
     "values": {
      "nm.page": 3,
      "nm.order": 4,
      "nm.scene": "SC-002",
      "nm.shot": "寄り",
      "nm.eye": "英国の人の目の高さ",
      "nm.mm": 1600,
      "nm.look": "メアリーの肩越しに",
      "nm.size": false,
      "nm.art": "ガリヴァー。",
      "nm.lines": "SC-002.L05",
      "nm.text": "台詞（ガリヴァー）：長くて2年。帰ったら、もう海には出ない。",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p04-k1",
     "values": {
      "nm.page": 4,
      "nm.order": 1,
      "nm.scene": "SC-002",
      "nm.shot": "寄り",
      "nm.eye": "英国の人の目の高さ",
      "nm.mm": 1600,
      "nm.look": "正面",
      "nm.size": false,
      "nm.art": "メアリーの顔。口元だけ笑っている。",
      "nm.lines": "SC-002.L06",
      "nm.text": "台詞（メアリー）：前もそう言いました。",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p04-k2",
     "values": {
      "nm.page": 4,
      "nm.order": 2,
      "nm.scene": "SC-002",
      "nm.shot": "中",
      "nm.eye": "英国の人の目の高さ",
      "nm.mm": 1600,
      "nm.look": "岸壁の人垣の後ろから",
      "nm.size": false,
      "nm.art": "メアリーは笑うが目は笑っていない。ガリヴァーは帽子を振って船に乗る。",
      "nm.lines": "SC-002.L07",
      "nm.text": "",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p04-k3",
     "values": {
      "nm.page": 4,
      "nm.order": 3,
      "nm.scene": "SC-002",
      "nm.shot": "大引き",
      "nm.eye": "俯瞰",
      "nm.mm": 30000,
      "nm.look": "港の外の丘から、出ていく船を",
      "nm.size": false,
      "nm.art": "台詞の無いコマ。港を出ていくアンテロープ号。",
      "nm.lines": "",
      "nm.text": "",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p05-k1",
     "values": {
      "nm.page": 5,
      "nm.order": 1,
      "nm.scene": "SC-003",
      "nm.shot": "大引き",
      "nm.eye": "水面すれすれ",
      "nm.mm": 2000,
      "nm.look": "波頭の高さから、岩に乗り上げる船を",
      "nm.size": false,
      "nm.art": "嵐の海。船が岩に乗り上げる。",
      "nm.lines": "SC-003.L01 SC-003.L02",
      "nm.text": "擬音：ゴォォォ",
      "nm.turn": "めくると嵐。"
     }
    },
    {
     "id": "e01-p05-k2",
     "values": {
      "nm.page": 5,
      "nm.order": 2,
      "nm.scene": "SC-003",
      "nm.shot": "寄り",
      "nm.eye": "水面すれすれ",
      "nm.mm": 3000,
      "nm.look": "甲板の高さ",
      "nm.size": false,
      "nm.art": "船首が砕ける。",
      "nm.lines": "SC-003.L03",
      "nm.text": "擬音：バキィ",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p05-k3",
     "values": {
      "nm.page": 5,
      "nm.order": 3,
      "nm.scene": "SC-003",
      "nm.shot": "中",
      "nm.eye": "水面すれすれ",
      "nm.mm": 300,
      "nm.look": "波間から",
      "nm.size": false,
      "nm.art": "6人の乗った小舟が転覆する。",
      "nm.lines": "SC-003.L04",
      "nm.text": "ナレーション（ガリヴァー）：11月5日、ヴァン・ディーメンの地の北西で、船は嵐に遭い、岩に砕けた。",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p06-k1",
     "values": {
      "nm.page": 6,
      "nm.order": 1,
      "nm.scene": "SC-003",
      "nm.shot": "中",
      "nm.eye": "水面すれすれ",
      "nm.mm": 300,
      "nm.look": "波間から、ひとり浮かぶ頭を",
      "nm.size": false,
      "nm.art": "波間にひとり浮かぶガリヴァー。",
      "nm.lines": "SC-003.L05",
      "nm.text": "ナレーション（ガリヴァー）：小舟で逃れた6人のうち、助かったのは私一人だったと思う。",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p06-k2",
     "values": {
      "nm.page": 6,
      "nm.order": 2,
      "nm.scene": "SC-003",
      "nm.shot": "中",
      "nm.eye": "水面すれすれ",
      "nm.mm": 300,
      "nm.look": "水中から",
      "nm.size": false,
      "nm.art": "泳ぐ。やがて足が底に着く。",
      "nm.lines": "SC-003.L06",
      "nm.text": "",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p06-k3",
     "values": {
      "nm.page": 6,
      "nm.order": 3,
      "nm.scene": "SC-003",
      "nm.shot": "引き",
      "nm.eye": "水面すれすれ",
      "nm.mm": 600,
      "nm.look": "浅瀬の先から、陸へ歩く背中を",
      "nm.size": false,
      "nm.art": "夕暮れの浅瀬を、1マイル近く歩く。",
      "nm.lines": "SC-003.L07",
      "nm.text": "ナレーション（ガリヴァー）：足が着いてから、1マイル近く歩いてようやく陸に上がった。夜の8時ごろだったろう。",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p07-k1",
     "values": {
      "nm.page": 7,
      "nm.order": 1,
      "nm.scene": "SC-003",
      "nm.shot": "引き",
      "nm.eye": "ガリヴァーの目の高さ",
      "nm.mm": 400,
      "nm.look": "浜の高さから、草地に倒れ込む姿を",
      "nm.size": false,
      "nm.art": "夜の浜。人家も人影もない。草の上に倒れ込む。",
      "nm.lines": "SC-003.L08",
      "nm.text": "ナレーション（ガリヴァー）：人家も人影もなかった。疲れと暑さと、船で飲んだ半パイントのブランデーで、私は短い柔らかな草の上に倒れ込んだ。",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p07-k2",
     "values": {
      "nm.page": 7,
      "nm.order": 2,
      "nm.scene": "SC-003",
      "nm.shot": "大寄り",
      "nm.eye": "小人の目の高さ",
      "nm.mm": 30,
      "nm.look": "草の根元から、眠る頬を",
      "nm.size": false,
      "nm.art": "頬のそばの短い柔らかな草。草の丈が低い。眠るガリヴァー。",
      "nm.lines": "SC-003.L09",
      "nm.text": "",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p08-k1",
     "values": {
      "nm.page": 8,
      "nm.order": 1,
      "nm.scene": "SC-004",
      "nm.shot": "大寄り",
      "nm.eye": "ガリヴァーの目の高さ",
      "nm.mm": 1630,
      "nm.look": "目の真上から",
      "nm.size": false,
      "nm.art": "仰向けのガリヴァーの目が開く。空。",
      "nm.lines": "SC-004.L01",
      "nm.text": "",
      "nm.turn": "朝。動けない（見開きの右）。"
     }
    },
    {
     "id": "e01-p08-k2",
     "values": {
      "nm.page": 8,
      "nm.order": 2,
      "nm.scene": "SC-004",
      "nm.shot": "中",
      "nm.eye": "ガリヴァーの目の高さ",
      "nm.mm": 300,
      "nm.look": "胸の高さから顔へ",
      "nm.size": false,
      "nm.art": "起き上がろうとして、身動き一つできない。",
      "nm.lines": "SC-004.L02",
      "nm.text": "ナレーション（ガリヴァー）：目が覚めたのは日が昇ってからだった。起き上がろうとして、身動き一つできないことに気づいた。",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p08-k3",
     "values": {
      "nm.page": 8,
      "nm.order": 3,
      "nm.scene": "SC-004",
      "nm.shot": "寄り",
      "nm.eye": "小人の目の高さ",
      "nm.mm": 136,
      "nm.look": "地面から、杭と糸を",
      "nm.size": false,
      "nm.art": "細い糸で地面に縫い止められた腕と脚、髪。",
      "nm.lines": "SC-004.L03 SC-004.L04",
      "nm.text": "ナレーション（ガリヴァー）：腕も脚も、長い髪までも、細い紐で地面に留められていた。",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p08-k4",
     "values": {
      "nm.page": 8,
      "nm.order": 4,
      "nm.scene": "SC-004",
      "nm.shot": "寄り",
      "nm.eye": "小人の目の高さ",
      "nm.mm": 136,
      "nm.look": "脚の脇の地面から",
      "nm.size": false,
      "nm.art": "左脚の上で、何かが動く。",
      "nm.lines": "SC-004.L05",
      "nm.text": "擬音：ガサッ",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p09-k1",
     "values": {
      "nm.page": 9,
      "nm.order": 1,
      "nm.scene": "SC-004",
      "nm.shot": "寄り",
      "nm.eye": "ガリヴァーの目の高さ",
      "nm.mm": 250,
      "nm.look": "顎の下から目へ",
      "nm.size": false,
      "nm.art": "何かが胸の上まで来る。目だけで見下ろすガリヴァー。",
      "nm.lines": "SC-004.L06",
      "nm.text": "",
      "nm.turn": "小人の初めての姿。ページの大ゴマ。"
     }
    },
    {
     "id": "e01-p09-k2",
     "values": {
      "nm.page": 9,
      "nm.order": 2,
      "nm.scene": "SC-004",
      "nm.shot": "大引き",
      "nm.eye": "小人の目の高さ",
      "nm.mm": 136,
      "nm.look": "胸の上の小人の後ろ、その目の高さから、山のような顎を見上げる",
      "nm.size": true,
      "nm.art": "身長6インチに満たない人間。弓矢と矢筒。後ろに40人ほど（AR-05）。",
      "nm.lines": "SC-004.L07",
      "nm.text": "",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p09-k3",
     "values": {
      "nm.page": 9,
      "nm.order": 3,
      "nm.scene": "SC-004",
      "nm.shot": "寄り",
      "nm.eye": "ガリヴァーの目の高さ",
      "nm.mm": 1630,
      "nm.look": "正面",
      "nm.size": false,
      "nm.art": "叫ぶガリヴァーの口。",
      "nm.lines": "SC-004.L08",
      "nm.text": "台詞（ガリヴァー）：うおっ！",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p10-k1",
     "values": {
      "nm.page": 10,
      "nm.order": 1,
      "nm.scene": "SC-004",
      "nm.shot": "中",
      "nm.eye": "小人の目の高さ",
      "nm.mm": 136,
      "nm.look": "脇腹の横の地面から",
      "nm.size": true,
      "nm.art": "驚いて胸から転げ落ちる小人たち。",
      "nm.lines": "SC-004.L09 SC-004.L10",
      "nm.text": "台詞（小人たち）：ヘキナ・デグル！",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p10-k2",
     "values": {
