     "values": {
      "nm.page": 10,
      "nm.order": 3,
      "nm.scene": "SC-004",
      "nm.shot": "中",
      "nm.eye": "小人の目の高さ",
      "nm.mm": 136,
      "nm.look": "隊の後ろから、指揮する小人を",
      "nm.size": false,
      "nm.art": "剣を振り上げて号令する小人の隊長。",
      "nm.lines": "SC-004.L13",
      "nm.text": "台詞（小人たち）：トルゴ・フォナク！",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p10-k4",
     "values": {
      "nm.page": 10,
      "nm.order": 4,
      "nm.scene": "SC-004",
      "nm.shot": "大引き",
      "nm.eye": "小人の目の高さ",
      "nm.mm": 136,
      "nm.look": "弓隊の列の中から、巨大な左手を",
      "nm.size": true,
      "nm.art": "百本を超える矢が、自由になった左手へ放たれる。",
      "nm.lines": "SC-004.L14 SC-004.L15",
      "nm.text": "擬音：ヒュンヒュン",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p11-k1",
     "values": {
      "nm.page": 11,
      "nm.order": 1,
      "nm.scene": "SC-004",
      "nm.shot": "寄り",
      "nm.eye": "ガリヴァーの目の高さ",
      "nm.mm": 300,
      "nm.look": "手の甲の上から",
      "nm.size": false,
      "nm.art": "針のような矢の刺さった左手。",
      "nm.lines": "SC-004.L16",
      "nm.text": "ナレーション（ガリヴァー）：百本を超える矢が、針のように左手に刺さった。私はじっとしていることにした。",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p11-k2",
     "values": {
      "nm.page": 11,
      "nm.order": 2,
      "nm.scene": "SC-004",
      "nm.shot": "中",
      "nm.eye": "ガリヴァーの目の高さ",
      "nm.mm": 300,
      "nm.look": "顔の横から",
      "nm.size": false,
      "nm.art": "じっと横たわり、夜を待つと決めるガリヴァー。",
      "nm.lines": "SC-004.L17",
      "nm.text": "ナレーション（ガリヴァー）：夜になれば、自由になった左手で逃げられる。相手がこの大きさならば、どんな軍勢でも敵ではない、と。",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p11-k3",
     "values": {
      "nm.page": 11,
      "nm.order": 3,
      "nm.scene": "SC-004",
      "nm.shot": "引き",
      "nm.eye": "小人の目の高さ",
      "nm.mm": 136,
      "nm.look": "足場の下の群衆の中から、演説する貴人と、その奥の耳を",
      "nm.size": true,
      "nm.art": "耳の脇に足場が組まれ、身分の高そうな小人が長い演説をする。",
      "nm.lines": "SC-004.L18",
      "nm.text": "",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p11-k4",
     "values": {
