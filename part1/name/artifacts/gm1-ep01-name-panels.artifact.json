      "nm.order": 4,
      "nm.scene": "SC-004",
      "nm.shot": "寄り",
      "nm.eye": "ガリヴァーの目の高さ",
      "nm.mm": 200,
      "nm.look": "口元",
      "nm.size": false,
      "nm.art": "指で口を差すガリヴァー。",
      "nm.lines": "SC-004.L19",
      "nm.text": "台詞（ガリヴァー）：（指で口を差す）……腹が、減っているのです。",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p11-k5",
     "values": {
      "nm.page": 11,
      "nm.order": 5,
      "nm.scene": "SC-004",
      "nm.shot": "引き",
      "nm.eye": "小人の目の高さ",
      "nm.mm": 136,
      "nm.look": "梯子の下から、胸へ上る運び手の列を",
      "nm.size": true,
      "nm.art": "胸に掛けた梯子。肉とパンの籠が運ばれる。",
      "nm.lines": "SC-004.L20",
      "nm.text": "",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p12-k1",
     "values": {
      "nm.page": 12,
      "nm.order": 1,
      "nm.scene": "SC-004",
      "nm.shot": "寄り",
      "nm.eye": "ガリヴァーの目の高さ",
      "nm.mm": 200,
      "nm.look": "口の前",
      "nm.size": false,
      "nm.art": "雲雀の翼より小さな肉を、二つ三つずつ摘む指。",
      "nm.lines": "SC-004.L21",
      "nm.text": "ナレーション（ガリヴァー）：肉はどれも、雲雀の翼より小さかった。私はそれを二つ三つずつ口に入れ、小銃の弾ほどのパンを一度に三つ食べた。",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p12-k2",
     "values": {
      "nm.page": 12,
      "nm.order": 2,
      "nm.scene": "SC-004",
      "nm.shot": "中",
      "nm.eye": "小人の目の高さ",
      "nm.mm": 136,
      "nm.look": "胸の上から、傾く樽と喉を",
      "nm.size": true,
      "nm.art": "樽を一息で飲み干す。",
      "nm.lines": "SC-004.L22 SC-004.L23",
      "nm.text": "台詞（小人たち）：ボラク・ミヴォラ！",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p12-k3",
     "values": {
      "nm.page": 12,
      "nm.order": 3,
      "nm.scene": "SC-004",
      "nm.shot": "引き",
      "nm.eye": "小人の目の高さ",
      "nm.mm": 136,
      "nm.look": "胸の上で踊る群れの中から",
      "nm.size": true,
      "nm.art": "放り投げた樽。胸の上で踊る小人たち。",
      "nm.lines": "SC-004.L24 SC-004.L25",
      "nm.text": "台詞（小人たち）：ヘキナ・デグル！",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p12-k4",
     "values": {
