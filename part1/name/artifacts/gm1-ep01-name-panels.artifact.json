      "nm.shot": "寄り",
      "nm.eye": "小人の目の高さ",
      "nm.mm": 136,
      "nm.look": "皇帝の正面",
      "nm.size": false,
      "nm.art": "皇帝。",
      "nm.lines": "SC-005.L13",
      "nm.text": "台詞（皇帝）：人の山だ。",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p16-k3",
     "values": {
      "nm.page": 16,
      "nm.order": 3,
      "nm.scene": "SC-005",
      "nm.shot": "寄り",
      "nm.eye": "小人の目の高さ",
      "nm.mm": 136,
      "nm.look": "皇帝の横顔を",
      "nm.size": false,
      "nm.art": "名を与える皇帝。",
      "nm.lines": "SC-005.L14",
      "nm.text": "台詞（皇帝）：……あれに、名を与えよ。クインバス・フレストリン。",
      "nm.turn": ""
     }
    },
    {
     "id": "e01-p16-k4",
     "values": {
